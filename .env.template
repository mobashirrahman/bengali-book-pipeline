# Private settings for this repository's manual scripts. Copy to .env; do
# not commit the result. Only fill in what the component you're running
# actually needs — most of these are independent of each other.

# Catalogue API server (catalogue.cli serve). CATALOGUE_ASSET_ROOT bounds
# which files /v2/assets/{id}/content may serve: a selected cover's
# storage_uri must resolve to a path under this root or the request 404s
# (catalogue/api/app.py _asset_content_path). CATALOGUE_CONTENT_ROOT is the
# equivalent bound for serving/downloading a document's own PDF/EPUB.
CATALOGUE_ASSET_ROOT=./pdf-craft-output/catalogue
CATALOGUE_CONTENT_ROOT=./data

# Postgres catalogue backend (optional; SQLite is the default and needs
# nothing here). See docs/en/CATALOGUE_BACKEND.md.
CATALOGUE_POSTGRES_DSN=

# Vendor OCR transports for the research study (pdf_craft_tool/research/
# vendor_transports.py, adapters.py). Values are redacted from every
# Prediction field and never appear in exported data; still, treat them as
# secrets like any other API key.
GOOGLE_VISION_API_KEY=
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=

# `book` does not read .env for OCR/LLM settings — it takes them as CLI
# flags instead: --tesseract, --tessdata, --ollama-url, --model (default
# http://127.0.0.1:11434 / qwen3.5:4b, an 8GB-GPU-friendly local proofreader
# via Ollama's OpenAI-compatible endpoint). See docs/en/BENGALI_BOOK_PIPELINE.md.
#
# The `pdf`/`package`/`batch` proofread commands (from the pdf-craft fork's
# own CLI) do read named PDF_CRAFT_LLM_* profiles from .env — see that
# fork's own .env.template for the full option list.
